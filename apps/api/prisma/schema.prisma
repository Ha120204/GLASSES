generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  FRAME
  LENS
  CONTACT
  ACCESSORY
}

enum OrderStatus {
  IN_PROGRESS
  AWAITING_PAYMENT
  DELIVERED
  CANCELLED
}

enum OrderType {
  PREORDER
  READY_SALE
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum UserRole {
  ADMIN
}

enum EyeExamAuditAction {
  CREATED
  UPDATED
  LOCKED
  UNLOCKED
  ARCHIVED
  RESTORED
}

enum OrderAuditAction {
  UPDATED
  ARCHIVED
  RESTORED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  createdOrders Order[] @relation("OrderCreator")
  cancelledOrders Order[] @relation("CancelledOrders")
  archivedOrders Order[] @relation("ArchivedOrders")
  orderPayments Payment[] @relation("OrderPayments")
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangeActor")
  orderAuditLogs OrderAuditLog[] @relation("OrderAuditActor")
  eyeExamAuditLogs EyeExamAuditLog[] @relation("EyeExamAuditActor")
  lockedEyeExams EyeExam[] @relation("EyeExamLocker")
  archivedEyeExams EyeExam[] @relation("EyeExamArchiver")
  @@map("users")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  birthday  DateTime? @db.Date
  gender    String?
  address   String?
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  eyeExams  EyeExam[]
  orders    Order[]
  @@index([phone])
  @@map("customers")
}

model EyeExam {
  id               String    @id @default(cuid())
  code             String    @unique @default(dbgenerated("next_eye_exam_code()"))
  idempotencyKey   String?   @unique @map("idempotency_key")
  requestHash      String?   @map("request_hash")
  customerId       String    @map("customer_id")
  examDate         DateTime  @map("exam_date") @db.Date
  examiner         String?
  rSph             Decimal?  @map("r_sph") @db.Decimal(5, 2)
  rCyl             Decimal?  @map("r_cyl") @db.Decimal(5, 2)
  rAxis            Int?      @map("r_axis")
  rAdd             Decimal?  @map("r_add") @db.Decimal(4, 2)
  rPd              Decimal?  @map("r_pd") @db.Decimal(5, 2)
  pdTotal          Decimal?  @map("pd_total") @db.Decimal(5, 2)
  rPrism           Decimal?  @map("r_prism") @db.Decimal(4, 2)
  rBase            String?   @map("r_base") @db.VarChar(2)
  rSegHeight       Decimal?  @map("r_seg_height") @db.Decimal(4, 1)
  lSph             Decimal?  @map("l_sph") @db.Decimal(5, 2)
  lCyl             Decimal?  @map("l_cyl") @db.Decimal(5, 2)
  lAxis            Int?      @map("l_axis")
  lAdd             Decimal?  @map("l_add") @db.Decimal(4, 2)
  lPd              Decimal?  @map("l_pd") @db.Decimal(5, 2)
  lPrism           Decimal?  @map("l_prism") @db.Decimal(4, 2)
  lBase            String?   @map("l_base") @db.VarChar(2)
  lSegHeight       Decimal?  @map("l_seg_height") @db.Decimal(4, 1)
  wearingPurpose   String?   @map("wearing_purpose")
  lensDesign       String?   @map("lens_design")
  noPrescription   Boolean   @default(false) @map("no_prescription")
  noPrescriptionReason String? @map("no_prescription_reason")
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  lockedAt         DateTime? @map("locked_at")
  lockedById       String?   @map("locked_by_id")
  archivedAt       DateTime? @map("archived_at")
  archivedById     String?   @map("archived_by_id")
  customer         Customer  @relation(fields: [customerId], references: [id])
  lockedBy         User?     @relation("EyeExamLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  archivedBy       User?     @relation("EyeExamArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  orders           Order[]
  auditLogs        EyeExamAuditLog[]
  @@index([archivedAt])
  @@map("eye_exams")
}

model EyeExamAuditLog {
  id          String             @id @default(cuid())
  eyeExamId   String             @map("eye_exam_id")
  action      EyeExamAuditAction
  changes     Json?              @db.JsonB
  createdAt   DateTime           @default(now()) @map("created_at")
  createdById String?            @map("created_by_id")
  eyeExam     EyeExam            @relation(fields: [eyeExamId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("EyeExamAuditActor", fields: [createdById], references: [id], onDelete: SetNull)
  @@index([eyeExamId, createdAt])
  @@index([createdById])
  @@map("eye_exam_audit_logs")
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  idempotencyKey String?         @unique @map("idempotency_key")
  requestHash    String?         @map("request_hash")
  barcode        String?         @unique
  name           String
  type           ProductType
  brand          String?
  costPrice      Int             @map("cost_price")
  salePrice      Int             @map("sale_price")
  supplier       String?
  active         Boolean         @default(true)
  deletedAt      DateTime?       @map("deleted_at")
  imageUpdatedAt DateTime?       @map("image_updated_at")
  image          ProductImage?
  orderItems     OrderItem[]
  @@map("products")
}

model ProductImage {
  productId String  @id @map("product_id")
  content   Bytes   @db.ByteA
  thumbnail Bytes?  @db.ByteA
  mimeType  String  @map("mime_type")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("product_images")
}

model Order {
  id            String          @id @default(cuid())
  code          String          @unique
  idempotencyKey String?         @unique @map("idempotency_key")
  requestHash    String?         @map("request_hash")
  customerId    String          @map("customer_id")
  createdById   String?         @map("created_by_id")
  eyeExamId     String?         @map("eye_exam_id")
  prescriptionSnapshot Json?    @map("prescription_snapshot") @db.JsonB
  orderType     OrderType       @default(PREORDER) @map("order_type")
  status        OrderStatus     @default(IN_PROGRESS)
  subtotal      Int
  discount      Int             @default(0)
  total         Int
  deposit       Int             @default(0)
  outstandingAmount Int         @default(0) @map("outstanding_amount")
  depositMethod PaymentMethod?  @map("deposit_method")
  dueDate       DateTime?       @map("due_date") @db.Date
  warrantyUntil DateTime?       @map("warranty_until") @db.Date
  note          String?
  cancellationReason String? @map("cancellation_reason")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  refundPendingAmount Int @default(0) @map("refund_pending_amount")
  refundMethod PaymentMethod? @map("refund_method")
  refundBankName String? @map("refund_bank_name")
  refundAccountNumber String? @map("refund_account_number")
  refundAccountName String? @map("refund_account_name")
  archivedAt    DateTime? @map("archived_at")
  archivedById  String?   @map("archived_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  customer      Customer        @relation(fields: [customerId], references: [id])
  createdBy     User?           @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  eyeExam       EyeExam?        @relation(fields: [eyeExamId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  cancelledBy   User?     @relation("CancelledOrders", fields: [cancelledById], references: [id], onDelete: SetNull)
  archivedBy    User?     @relation("ArchivedOrders", fields: [archivedById], references: [id], onDelete: SetNull)
  statusHistory OrderStatusHistory[]
  auditLogs     OrderAuditLog[]
  @@index([status])
  @@index([refundPendingAmount])
  @@index([archivedAt, createdAt])
  @@index([dueDate])
  @@index([customerId])
  @@index([createdById])
  @@map("orders")
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String      @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus @map("to_status")
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("OrderStatusChangeActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([createdById])
  @@map("order_status_history")
}

model OrderAuditLog {
  id          String           @id @default(cuid())
  orderId     String           @map("order_id")
  action      OrderAuditAction
  changes     Json?            @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at")
  createdById String?          @map("created_by_id")
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("OrderAuditActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([createdById])
  @@map("order_audit_logs")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String?  @map("product_id")
  name      String
  unitPrice Int      @map("unit_price")
  qty       Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  @@map("order_items")
}

model Payment {
  id       String        @id @default(cuid())
  orderId  String        @map("order_id")
  idempotencyKey String? @unique @map("idempotency_key")
  requestHash String? @map("request_hash")
  amount   Int
  method   PaymentMethod
  type     PaymentType @default(PAYMENT)
  createdById String?  @map("created_by_id")
  paidAt   DateTime      @default(now()) @map("paid_at")
  note     String?
  reference String? @map("reference")
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("OrderPayments", fields: [createdById], references: [id], onDelete: SetNull)
  @@index([createdById])
  @@map("payments")
}

model Setting {
  id                    String  @id @default(cuid())
  storeName             String  @map("store_name")
  address               String?
  phone                 String?
  invoiceTemplate       String? @map("invoice_template")
  qrPaymentEnabled      Boolean @default(false) @map("qr_payment_enabled")
  bankName              String? @map("bank_name")
  bankBin               String? @map("bank_bin")
  bankAccountNumber     String? @map("bank_account_number")
  bankAccountName       String? @map("bank_account_name")
  transferContentPrefix String  @default("DH") @map("transfer_content_prefix")
  @@map("settings")
}
